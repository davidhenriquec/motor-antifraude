      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(antifraude_transacoes_com_alerta_total[5m])) / sum(rate(antifraude_transacoes_avaliadas_total[5m]))",
          "legendFormat": "% alertadas",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
